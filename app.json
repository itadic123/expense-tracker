{
  "expo": {
    "name": "Трошкомер",
    "slug": "expense-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E9EFEA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "rs.itadic.expensetracker"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Апликацији је потребан приступ галерији да бисте изабрали профилну слику.",
          "cameraPermission": "Апликацији је потребан приступ камери да бисте сликали профилну слику и скенирали рачуне."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Апликацији је потребан приступ камери да бисте скенирали QR код са рачуна.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "scheme": "expensetracker"
  }
}
